# ===========================
# SIPDOK .gitignore
# ===========================

# ----- OS Files -----
.DS_Store
Thumbs.db
*.swp
*.swo

# ----- IDE -----
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ----- Docker Volumes -----
postgres_data/
redis_data/

# ----- Environment -----
.env
.env.local
.env.production
backend/.env
frontend/.env
frontend/.env.local
!backend/.env.example
!backend/.env.testing

# ----- Backend (Laravel) -----
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*
!backend/storage/framework/cache/.gitkeep
!backend/storage/framework/sessions/.gitkeep
!backend/storage/framework/views/.gitkeep
!backend/storage/logs/.gitkeep
!backend/bootstrap/cache/.gitkeep

# ----- Backend Testing -----
backend/.phpunit.result.cache
backend/coverage/

# ----- Frontend (Vue/Vite) -----
frontend/node_modules/
frontend/dist/

# ----- Misc -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
